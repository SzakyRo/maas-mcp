# maasmcp environment template.
#
# Copy this file to `.env` and fill in real values. The `.env*` glob in
# `.gitignore` excludes every `.env*` file EXCEPT this template.
#
# All variables use the `MAASMCP_` prefix with `__` as the nested-key
# delimiter (see `src/maasmcp/config.py`). Two settings are required; the
# rest override defaults from `ServerConfig` / `MaasConfig`.

# ─── required ─────────────────────────────────────────────────────────────
# MAAS root URL (e.g. https://maas.example.com/MAAS).
MAASMCP_MAAS__BASE_URL=https://maas.example.com/MAAS

# MAAS API key. Either the compact three-part form
#   "<consumer_key>:<token_key>:<token_secret>"
# (MAAS's default — auto-split into OAuth fields at validation time) or a
# raw opaque Bearer key for newer MAAS deployments. The server handles
# both.
MAASMCP_MAAS__API_KEY=

# Bearer token gating `/mcp`. Generate with `openssl rand -hex 16` (or
# longer) for anything beyond a trusted LAN. `/healthz` is exempt.
# Must be non-empty — an empty value would authenticate headerless
# requests and is rejected at startup.
MAASMCP_SERVER__BEARER_TOKEN=

# ─── optional: MAAS connection ────────────────────────────────────────────
# Verify the MAAS TLS certificate. Default: true.
MAASMCP_MAAS__VERIFY_TLS=true

# Explicit opt-in to send OAuth/Bearer credentials over plain http://.
# Default: false. Refuse-by-default: setting this true is the only way to
# construct MaasClient against an http:// MAAS URL.
# MAASMCP_MAAS__ALLOW_INSECURE=false

# ─── optional: HTTP server ────────────────────────────────────────────────
# Bind address. Default: 0.0.0.0.
# MAASMCP_SERVER__HOST=0.0.0.0

# HTTP port. Default: 8765.
# MAASMCP_SERVER__PORT=8765

# Log level for uvicorn + structlog. Default: info.
# MAASMCP_SERVER__LOG_LEVEL=info

# Hard cap on auto-paginated list results. Default: 1000.
# MAASMCP_SERVER__MAX_PAGINATED_ITEMS=1000

# Per-request timeout (seconds) for a single MAAS API call. Default: 300.
# MAASMCP_SERVER__REQUEST_TIMEOUT_SECONDS=300

# ─── end-to-end tests (manual only) ────────────────────────────────────────
# These are consumed by `tests/e2e/` only when running `pytest -m e2e`.
# They never affect a live server. Do NOT set them in a deployment .env
# unless you intend to run the e2e suite against this MAAS instance.
#
# Acquire/release flow:
# MAASMCP_E2E_URL=https://maas.example.com/MAAS
# MAASMCP_E2E_KEY=
#
# Bulk / storage flows:
# MAASMCP_E2E_MAAS_URL=https://maas.example.com/MAAS
# MAASMCP_E2E_SYSTEM_ID=
